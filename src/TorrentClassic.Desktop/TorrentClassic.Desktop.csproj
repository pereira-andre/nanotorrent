<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NanoTorrent</AssemblyName>
    <Version>1.1.1</Version>
    <Product>NanoTorrent</Product>
    <Description>Portable, ad-free classic BitTorrent client</Description>
    <ApplicationIcon>../TorrentClassic.App/app.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../docs/icon.png" LogicalName="TorrentClassic.Desktop.app-icon.png" />
    <ProjectReference Include="../TorrentClassic.Core/TorrentClassic.Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
  </ItemGroup>
</Project>
